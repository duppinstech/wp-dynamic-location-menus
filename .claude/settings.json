{
    "permissions": {
        "deny": [
            "Read(.env)",
            "Read(.env.*)",
            "Bash(git push --force)",
            "Bash(git push --force *)",
            "Bash(git push -f)",
            "Bash(git push -f *)",
            "Bash(git reset --hard)",
            "Bash(git reset --hard *)",
            "Bash(git clean)",
            "Bash(git clean *)"
        ]
    }
}
